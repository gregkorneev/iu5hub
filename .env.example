# The optional public Worker origin used by the deployed Mini App. This is not
# a secret; omit it for same-origin local development. Configure it in
# Cloudflare Pages build settings, not in a committed .env file.
# VITE_ANALYTICS_API_BASE=https://<worker-subdomain>.<account>.workers.dev
#
# No secret frontend environment variables are required.
#
# Never put a Telegram Bot token, Cloud.ru access key, secret key, OAuth secret,
# password, or private key in this file. Every VITE_* value is embedded into the
# public browser bundle at build time.
#
# Cloud.ru deployment settings belong in GitHub Environment secrets/variables,
# not in a local frontend .env file.
#
# Never put a Telegram Bot token, Cloud.ru access key, secret key, OAuth secret,
# password, or private key in this file. Every VITE_* value is embedded into the
# public browser bundle at build time.
#
# Cloud.ru deployment settings belong in GitHub Environment secrets/variables,
# not in a local frontend .env file.
